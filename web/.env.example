# Data provider: mock | api
NEXT_PUBLIC_DATA_PROVIDER=mock

# Backend API base (Phase 3) — used when NEXT_PUBLIC_DATA_PROVIDER=api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5088

# Didban read-only connection belongs to the API user-secrets / env — not the Next app.
# See api/README.md and api/AiTicket.Api/appsettings.Development.example.json
